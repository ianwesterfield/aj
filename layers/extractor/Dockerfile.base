# =============================================================================
# AJ Extractor API - Base Image
# =============================================================================
# Contains: Python 3.11 + system deps (ffmpeg, git) + all pip packages
# Publish:  docker build -f Dockerfile.base -t <hub>/aj-extractor-base:latest .
#           docker push <hub>/aj-extractor-base:latest
#
# This image rarely changes (only when requirements.txt is updated)
# Slim: no torch/transformers — vision is remote, audio uses CTranslate2
# =============================================================================

FROM python:3.11-slim

# System dependencies (ffmpeg for audio, git for pip installs)
RUN apt-get update && apt-get install -y --no-install-recommends \
  ffmpeg \
  libsndfile1 \
  git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python packages (the expensive layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# CTranslate2 (faster-whisper) finds cuBLAS/cuDNN from the pip wheels
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib

# Base image stops here - no application code
